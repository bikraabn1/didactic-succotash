# -- Audit noise ------------------------------------------------------------
# `audit=false` menyembunyikan ringkasan vulnerability dari output `npm install`
# supaya install tetap bersih. Ini TIDAK menghilangkan dependency apa pun dan
# TIDAK mematikan `npm audit` manual -- jalankan `npm audit` kapan saja untuk
# cek langsung.
#
# Alasannya: satu advisory (GHSA-vfj7-8cjw-p6xm / CVE-2026-93687, stack-overflow
# DoS di `braces`) menular ke 21 baris laporan lewat rantai tooling build/lint:
#   braces <- micromatch <- fast-glob <- @adonisjs/assembler / hot-hook / eslint-plugin
# Sampai sekarang belum ada patch resmi (braces@3.0.3 = versi terbaru, upstream
# issue masih open), dan paket ini tidak dipakai di jalur runtime maupun menerima
# input dari user, jadi tidak ada permukaan serangan nyata di proyek ini.
# Sementara kita tunggu patch resmi, install dibikin senyap dari sini.
#
# TODO: begitu braces merilis versi yang sudah dipatch, hapus baris
#       `audit=false` di bawah dan jalankan `npm audit` untuk memastikan bersih.
audit=false

# Sembunyikan juga pesan "packages are looking for funding" biar output rapi.
fund=false
